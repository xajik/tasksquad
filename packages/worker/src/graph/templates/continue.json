{
  "instruction": "After user input, verify checkpoint and baseline; decide resume, restart or blocked. Do not repeat an external action. Confirm termination and baseline restoration before authorizing another side-effecting attempt. Resume requires a verified checkpoint.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "decision": {
        "type": "string",
        "enum": [
          "resume",
          "restart",
          "blocked"
        ]
      },
      "reason": {
        "type": "string",
        "maxLength": 3999
      },
      "checkpoint_verified": {
        "type": "boolean"
      },
      "baseline_unchanged": {
        "type": "boolean"
      },
      "termination_verified": {
        "type": "boolean"
      }
    },
    "required": [
      "decision",
      "reason",
      "checkpoint_verified",
      "baseline_unchanged",
      "termination_verified"
    ]
  }
}
