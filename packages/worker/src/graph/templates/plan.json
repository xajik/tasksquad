{
  "instruction": "Propose bounded actions from permitted observations. Include baseline, restoration predicates, steps, undo, resources and both budgets. resource_versions must contain the exact immutable resource row IDs supplied in context, without appending @version or any other suffix. from_id must be the ID of a supplied active observation, never an unexecuted milestone or goal. Preserve exact named success predicates and scope from the task in action body and steps, including the read-back needed to establish each predicate. Do not execute. Declare projected_impact: for each goal in context.goals that this action should advance, give its goal_id and the projected share (0 to 1) of that goal's listed predicates the action will move toward true once its read-backs verify them. Omit goals the action will not move.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 299
            },
            "description": {
              "type": "string",
              "maxLength": 299
            },
            "body": {
              "type": "string",
              "maxLength": 3999
            },
            "from_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 299
            },
            "baseline": {
              "type": "string",
              "maxLength": 3999
            },
            "restoration_predicates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "undo_steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "recovery_cost": {
              "type": "number",
              "minimum": 0
            },
            "resource_versions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "effects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "expected_quality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "projected_impact": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "goal_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 299
                  },
                  "delta": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "goal_id",
                  "delta"
                ]
              }
            }
          },
          "required": [
            "title",
            "description",
            "body",
            "from_id",
            "baseline",
            "restoration_predicates",
            "steps",
            "undo_steps",
            "cost",
            "recovery_cost",
            "resource_versions",
            "effects",
            "expected_quality"
          ]
        },
        "maxItems": 5
      }
    },
    "required": [
      "actions"
    ]
  }
}
