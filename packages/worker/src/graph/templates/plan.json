{
  "instruction": "Propose bounded actions from permitted observations. Include baseline, restoration predicates, steps, undo, resources and both budgets. Do not execute.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 299
            },
            "description": {
              "type": "string",
              "maxLength": 299
            },
            "body": {
              "type": "string",
              "maxLength": 3999
            },
            "from_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 299
            },
            "baseline": {
              "type": "string",
              "maxLength": 3999
            },
            "restoration_predicates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "undo_steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "recovery_cost": {
              "type": "number",
              "minimum": 0
            },
            "resource_versions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "effects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 299
              },
              "maxItems": 20
            },
            "expected_quality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "title",
            "description",
            "body",
            "from_id",
            "baseline",
            "restoration_predicates",
            "steps",
            "undo_steps",
            "cost",
            "recovery_cost",
            "resource_versions",
            "effects",
            "expected_quality"
